{
  "ui.diagnostic.staticcheck": true,
  "ui.completion.experimentalPostfixCompletions": true,
  "formatting.gofumpt": true,
  "ui.inlayhint.hints": {
    "compositeLiteralFields": true,
    "constantValues": true,
    "functionTypeParameters": true,
    "parameterNames": true,
    "rangeVariableTypes": true
  },
  "analyses": {
    "fillstruct": true,
    "nonewvars": true,
    "noresultvalues": true,
    "undeclaredname": true,
    "unusedparams": true
  }
}
