# CostScope production .env example
ENV=production
LOG_LEVEL=info
COSTSCOPE_PORT=8080
# Set a strong random secret in production (32+ chars), do not commit real value
COSTSCOPE_JWT_SECRET=

# CORS allowed origins (comma-separated). Avoid '*' in production.
CORS_ORIGINS=http://localhost:3000

# Optional Casbin RBAC (set paths to enable)
# Use the provided examples by default; replace with your own in production.
CASBIN_MODEL_PATH=./configs/rbac_model.conf.example
CASBIN_POLICY_PATH=./configs/rbac_policy.csv.example
# CASBIN_DOMAIN=default
# CASBIN_ANON_SUBJECT=role:reader

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=costscope
