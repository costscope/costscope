#!/bin/bash

# CostScope Pre-commit Hook
# Runs comprehensive quality checks before allowing commits

set -e

echo " Running pre-commit quality checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_status() {
    echo -e "${BLUE}[PRE-COMMIT]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# Check if we're in a Git repository
if [ ! -d .git ]; then
    print_error "Not in a Git repository"
    exit 1
fi

# Block committing sensitive/local artifacts regardless of file types
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM || true)
if echo "$STAGED_ALL" | grep -E '(^|/)jwt\.secret$|^costscope-data/|^docs/security/security-summary\.(md|json)$' >/dev/null 2>&1; then
    print_error "Staged changes include forbidden files/paths (jwt.secret or costscope-data/). Remove them from the commit."
    echo "$STAGED_ALL" | grep -E '(^|/)jwt\.secret$|^costscope-data/|^docs/security/security-summary\.(md|json)$' || true
    exit 1
fi

# Get list of staged Go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    print_status "No Go files staged for commit"
    exit 0
fi

print_status "Staged Go files: $(echo $STAGED_GO_FILES | wc -w)"

# 0. Compilation check (clean cache to catch all issues)
print_status " Checking compilation without cache..."
clean_go_cache() {
    # Try normal clean first (include test cache)
    if go clean -cache -testcache >/dev/null 2>&1; then
        return 0
    fi

    print_warning "go clean failed; retrying..."
    sleep 0.5
    if go clean -cache -testcache >/dev/null 2>&1; then
        return 0
    fi

    # Fallback: force-clear GOCACHE when it gets into a bad state (macOS unlinkat issue)
    GOCACHE_DIR=$(go env GOCACHE 2>/dev/null || true)
    if [ -n "$GOCACHE_DIR" ] && [[ "$GOCACHE_DIR" == *"/go-build"* ]]; then
        print_warning "Force-clearing Go build cache at $GOCACHE_DIR"
        rm -rf "$GOCACHE_DIR" 2>/dev/null || true
        mkdir -p "$GOCACHE_DIR" 2>/dev/null || true
        return 0
    fi

    return 1
}

if ! clean_go_cache; then
    print_error "Failed to clean cache"
    exit 1
fi

if ! go build ./...; then
    print_error "Compilation failed! Fix compilation errors before committing."
    exit 1
fi
print_success "Compilation check passed"

# 1. Format check
print_status " Checking code formatting..."
UNFORMATTED_FILES=$(goimports -l $STAGED_GO_FILES || true)
if [ -n "$UNFORMATTED_FILES" ]; then
    print_error "The following files are not formatted:"
    echo "$UNFORMATTED_FILES"
    print_status "Run 'make fmt' to fix formatting"
    exit 1
fi
print_success "Code formatting OK"

# 2. Build check
print_status " Checking if code builds..."
if ! go build ./...; then
    print_error "Build failed"
    exit 1
fi
print_success "Build OK"

# 3. Linting (moved before tests to fail fast and avoid running full test suite on lint errors)
print_status " Running linter (pre-tests)..."
if ! golangci-lint run ./...; then
    print_error "Linting failed"
    print_status "Run 'make lint-fix' to attempt automatic fixes"
    exit 1
fi
print_success "Linting OK"

# 4. Test check
print_status " Running tests..."
if ! go test ./...; then
    print_error "Tests failed"
    exit 1
fi
print_success "Tests OK"

# 5. Duplicate detection
print_status " Checking for duplicates (dupl gate)..."
# Use maintained Make target; fallback is non-fatal if target missing
if make -q duplicates-gate 2>/dev/null; then
    if ! make duplicates-gate; then
        print_error "Duplication gate failed"
        exit 1
    fi
    print_success "Duplication gate passed"
else
    # Older envs may not have duplicates-gate; try basic duplicates target
    if make -q duplicates 2>/dev/null; then
        if ! make duplicates; then
            print_error "Duplicate scan failed"
            exit 1
        fi
        print_success "Duplicate scan completed (no gate enforced)"
    else
        print_warning "No duplicates targets found; skipping duplicate check"
    fi
fi

# 5b. Cyclomatic complexity guard (only for staged files)
print_status " Checking cyclomatic complexity (threshold 25)..."
if [ -x scripts/tools/check_cc.sh ]; then
    if ! scripts/tools/check_cc.sh $STAGED_GO_FILES; then
        print_error "Cyclomatic complexity threshold exceeded"
        exit 1
    fi
else
    print_warning "Complexity checker script missing (scripts/tools/check_cc.sh)"
fi
print_success "Complexity check OK"

# 6. Integration Action DSL: validate + generate
print_status " Validating/generating Integration Action DSL..."
if make -q gen-actions 2>/dev/null; then
    if ! make gen-actions; then
        print_error "Integration Action DSL validation failed"
        exit 1
    fi
    # generate code to keep repo consistent
    if make -q gen-actions-generate 2>/dev/null; then
        if ! make gen-actions-generate; then
            print_error "Integration Action DSL generation failed"
            exit 1
        fi
    fi
else
    print_warning "No gen-actions target; skipping DSL checks"
fi
print_success "Integration Action DSL OK"

# 7. Security check (blocking on HIGH severity)
print_status " Running security check (blocking HIGH severity)..."
TMP_GOSEC=$(mktemp)
if gosec -fmt=json -out "$TMP_GOSEC" ./... >/dev/null 2>&1; then
    if jq -e '.Issues[] | select(.severity=="HIGH")' "$TMP_GOSEC" >/dev/null 2>&1; then
        print_error "HIGH severity gosec issue detected (see $TMP_GOSEC)"
        exit 1
    fi
else
    print_warning "gosec execution failed; proceeding but please investigate"
fi
print_success "Security check OK (no HIGH severity)"

# 7b. API contract guard (only if API handlers or spec templates changed)
print_status " Evaluating API contract guard trigger..."
if git diff --cached --name-only | grep -E 'internal/api/|internal/api/docs/.*template|cmd/modules/api' >/dev/null 2>&1; then
    print_status "API-related changes detected; running contract-check..."
    if make -q contract-check 2>/dev/null; then
        if ! make contract-check; then
            print_error "API contract check failed"
            exit 1
        fi
        print_success "API contract stable"
    else
        print_warning "contract-check target missing; skip API contract guard"
    fi
else
    print_status "No API changes detected; skipping contract-check"
fi

# 8. Check for common issues
print_status " Checking for common issues..."

# Check for TODO/FIXME comments in staged files
TODO_COUNT=$(grep -n "TODO\|FIXME" $STAGED_GO_FILES | wc -l || true)
if [ "$TODO_COUNT" -gt 0 ]; then
    print_warning "Found $TODO_COUNT TODO/FIXME comments in staged files"
fi

# Check for debug prints
DEBUG_PRINTS=$(grep -n "fmt.Print\|log.Print" $STAGED_GO_FILES | grep -v "_test.go" | wc -l || true)
if [ "$DEBUG_PRINTS" -gt 0 ]; then
    print_warning "Found $DEBUG_PRINTS potential debug prints in non-test files"
fi

print_success "Common issues check OK"

# 9. Secrets scan (optional if gitleaks installed)
print_status " Running secrets scan..."
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks detect --no-banner --redact --exit-code 1 --staged --config .gitleaks.toml; then
        print_error "Secret patterns detected by gitleaks"
        exit 1
    fi
    print_success "Secrets scan OK"
else
    print_warning "gitleaks not installed; skip secrets scan"
fi

print_success " All pre-commit checks passed!"
echo ""
print_status "Commit proceeding..."

# 10. Perf + Parity guard for mapper changes (runs only when mappers are staged)
print_status " Evaluating mapper changes for perf+parity run..."
STAGED_MAPPER_FILES=$(git diff --cached --name-only | grep -E '^internal/core/focus/conversion/(aws|azure|gcp|common)/' || true)
if [ -n "$STAGED_MAPPER_FILES" ]; then
    print_status "Mapper-related changes detected:" 
    echo "$STAGED_MAPPER_FILES" | sed 's/^/  - /'

    # Ensure a runnable ./costscope binary exists for parity checks
    if [ ! -x ./costscope ]; then
        if [ -x bin/costscope ]; then
            print_status "Linking bin/costscope -> ./costscope for parity run"
            ln -sf bin/costscope ./costscope || cp bin/costscope ./costscope
            chmod +x ./costscope || true
        else
            print_status "Building slim binary for parity run..."
            if ! make -s build-slim; then
                print_error "Failed to build costscope binary required for perf-parity"
                exit 1
            fi
            ln -sf bin/costscope ./costscope || cp bin/costscope ./costscope
            chmod +x ./costscope || true
        fi
    fi

    # Run perf-parity (short perf bench + aggregate parity)
    if make -q perf-parity 2>/dev/null; then
        print_status "Running make perf-parity (this may take ~1-2 minutes)..."
        if ! make perf-parity; then
            print_error "perf-parity failed (performance regression or parity mismatch)"
            exit 1
        fi
        print_success "perf-parity OK"
    else
        print_warning "No perf-parity target found; skipping perf+parity guard"
    fi
else
    print_status "No mapper changes detected; skipping perf+parity"
fi
