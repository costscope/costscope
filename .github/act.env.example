## Example environment file for `act`
# Copy to .github/act.env and adjust. Unset lines are safe.

GO_VERSION=1.24.6
COSTSCOPE_INVARIANTS_TOLERANCE=0.01
PARITY_TOLERANCE=1e-9
INVARIANTS_TOLERANCE=0.01
PERF_BENCH_DURATION_MAX=1.15
PERF_BENCH_ALLOC_MAX=1.20

# --- Image resolution for containerized jobs (unified with CI) ---
# Precedence used by scripts/ci/resolve-ci-image.sh:
#   1) CI_TOOLS_IMAGE (full ref, prefer @sha256:digest)
#   2) CI_IMAGE_REPO + CI_IMAGE_TAG
#   3) CI_IMAGE_REPO + ':latest' if RESOLVE_CI_IMAGE_ALLOW_LATEST=true or act is detected

# Indicate act context explicitly (enables some safe fallbacks in scripts)
IS_ACT=true
ACT=true
# Enable only if you intentionally want full/heavy jobs locally (some are disabled regardless)
ACT_FULL=false

# Recommended for GitHub-hosted CI (immutable and reproducible):
# CI_TOOLS_IMAGE=ghcr.io/costscope/ci-base@sha256:7d6d716eb9bab9f581feb498162fd8a24775fcf306a9ee724c2185b12aa9c05f

# Defaults for local act runs:
# - We typically map images to a local tag (e.g., dev-local) via `act -P ...`
# - Keeping CI_TOOLS_IMAGE unset allows repo+tag to be used, matching your -P mapping.
CI_TOOLS_IMAGE=
CI_IMAGE_REPO=ghcr.io/costscope/ci-base
# Use a stable local tag you substitute with `-P ghcr.io/costscope/ci-base:latest=ghcr.io/costscope/ci-base:dev-local` (or similar)
CI_IMAGE_TAG=dev-local
# Optionally permit ':latest' if CI_IMAGE_TAG is empty (not needed when CI_IMAGE_TAG is set)
RESOLVE_CI_IMAGE_ALLOW_LATEST=true

# Shellcheck image (not currently consumed by this repo's workflows, provided for consistency)
# Tag form (easy to rotate locally):
# CI_SHELLCHECK_IMAGE=ghcr.io/costscope/ci-shellcheck:2025.10.24-6b799a83
# Digest form (immutable):
# CI_SHELLCHECK_IMAGE=ghcr.io/costscope/ci-shellcheck@sha256:<digest>

# Notes:
# - If you set CI_TOOLS_IMAGE, it takes precedence over CI_IMAGE_REPO/TAG.
# - For act, prefer CI_IMAGE_TAG=dev-local plus `-P` mappings to avoid GHCR auth during local runs.
# - In CI, prefer CI_TOOLS_IMAGE pinned by digest for determinism; repo variables can set it centrally.
