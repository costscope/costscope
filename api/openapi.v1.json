{
  "openapi": "3.1.0",
  "info": {
    "title": "CostScope FOCUS API",
    "description": "Baseline snapshot (community) 2025-08-26. Additive changes only; removals require version bump.",
    "version": "1.0.0",
    "contact": {
      "name": "CostScope API Support",
      "email": "api-support@costscope.io"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Development server"
    },
    {
      "url": "https://api.costscope.io",
      "description": "Production server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Server is healthy"
          }
        }
      }
    },
    "/api/v1/analytics/summary": {
      "get": {
        "summary": "Get cost summary",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/analytics/top-services": {
      "get": {
        "summary": "Top services",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/analytics/trends": {
      "get": {
        "summary": "Cost trends",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/focus/conversions": {
      "post": {
        "summary": "Start FOCUS conversion",
        "responses": {
          "202": {
            "description": "Accepted"
          }
        }
      }
    },
    "/api/v1/focus/conversions/history": {
      "get": {
        "summary": "List conversion jobs",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/focus/conversions/{id}": {
      "get": {
        "summary": "Get conversion job",
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/focus/schemas": {
      "get": {
        "summary": "List FOCUS schemas",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {}
}